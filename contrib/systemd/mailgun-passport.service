[Unit]
Description=Mailgun Passport (local SMTP relay to the Mailgun API)
Documentation=https://github.com/devrfc83/mailgun-passport
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mailgun-passport
Group=mailgun-passport
ExecStart=/usr/bin/mailgun-passport
Restart=on-failure
RestartSec=5
# Exit status 2 means invalid configuration: restarting will not fix it.
RestartPreventExitStatus=2

# Read by systemd as root, so the file can stay 0600 root:root.
EnvironmentFile=-/etc/mailgun-passport/mailgun-passport.env
# Per-setting overrides belong in a drop-in: systemctl edit mailgun-passport

# Logs go to the journal. For a file as well, set
# LOG_FILE=/var/log/mailgun-passport/mailgun-passport.log (this directory is writable).
LogsDirectory=mailgun-passport
LogsDirectoryMode=0750

# Port 587 is privileged.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening. Directives unknown to older systemd versions are ignored.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
