[Unit]
Description=Mailgun Passport (SMTP local → Mailgun API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mailgun-passport
Group=mailgun-passport
WorkingDirectory=/opt/mailgun-passport
ExecStart=/usr/local/bin/mailgun-passport
Restart=on-failure
RestartSec=3

# Prefer an environment file (does not override variables already defined).
EnvironmentFile=-/etc/mailgun-passport.env

# Alternative: SetEnv / Environment= in this unit.
# Environment=SMTP_LISTEN=127.0.0.1:587
# Environment=MAILGUN_API_KEY=key-xxxxxxxx
# Environment=MAILGUN_DOMAIN=mg.example.com
# Environment=MAILGUN_API_BASE=us
# Environment=MAILGUN_SEND_MODE=parsed
# Environment=LOG_FILE=/var/log/mailgun-passport.log

# Port 587 is privileged if the process is not root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=

[Install]
WantedBy=multi-user.target
