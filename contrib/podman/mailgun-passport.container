# Podman Quadlet unit. Copy to /etc/containers/systemd/ (or
# ~/.config/containers/systemd/ for a rootless user), create the env file and run:
#   systemctl daemon-reload && systemctl start mailgun-passport
[Unit]
Description=Mailgun Passport (local SMTP relay to the Mailgun API)
After=network-online.target
Wants=network-online.target

[Container]
# A fixed name, so ExecReload below can find the container.
ContainerName=mailgun-passport
# Built with `make image` by the same user (root for /etc/containers/systemd).
# Point it at a registry instead once the image is published, e.g.
# ghcr.io/devrfc83/mailgun-passport:latest.
Image=localhost/mailgun-passport:latest
# Same format as .env.example. With SMTP_USERNAME/SMTP_PASSWORD set, add
# SMTP_ALLOW_INSECURE_AUTH=true or configure STARTTLS.
EnvironmentFile=/etc/mailgun-passport/mailgun-passport.env
# Only reachable from this host.
PublishPort=127.0.0.1:587:2525
# With QUEUE_DIR=/var/lib/mailgun-passport in the env file, keep the queue in a
# volume, so messages survive the container being replaced. Uncomment:
#Volume=mailgun-passport-spool.volume:/var/lib/mailgun-passport:Z
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
# Runs `mailgun-passport -healthcheck` (HEALTH_LISTEN is set in the image)
# and restarts the container when /health keeps failing.
HealthCmd=/usr/bin/mailgun-passport -healthcheck
HealthOnFailure=kill

[Service]
Restart=on-failure
RestartPreventExitStatus=2
# systemctl reload: the relay reads *_FILE secrets again, reloads the STARTTLS
# certificate and reopens its log file. A changed EnvironmentFile= needs a restart.
ExecReload=/usr/bin/podman kill --signal=HUP mailgun-passport

[Install]
WantedBy=multi-user.target default.target
