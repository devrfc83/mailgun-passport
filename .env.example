# mailgun-passport configuration.
# Installed packages read /etc/mailgun-passport/mailgun-passport.env. Elsewhere,
# pass this file with --env-file or name it in PASSPORT_ENV_FILE; it is never
# read implicitly.
# Empty or commented-out settings use the default shown.
# Write plain KEY=value lines: no quotes, no $, no comments after a value.

# --- Mailgun (required) -------------------------------------------------------
# https://app.mailgun.com/settings/api_security
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Read the API key from a file instead (container secret, systemd credential).
# Leave MAILGUN_API_KEY empty when using it.
#MAILGUN_API_KEY_FILE=

# us | eu | full URL (e.g. https://api.mailgun.net)
#MAILGUN_API_BASE=us
#MAILGUN_TIMEOUT=30s
#MAILGUN_TESTMODE=false

# mime:   forward the original message to POST /v3/{domain}/messages.mime
#         (keeps every header, MIME structure and inline image intact)
# parsed: rebuild the message from its fields via POST /v3/{domain}/messages
#MAILGUN_SEND_MODE=mime

# --- SMTP listener ------------------------------------------------------------
#SMTP_LISTEN=127.0.0.1:587
#SMTP_DOMAIN=localhost
#SMTP_MAX_MESSAGE_BYTES=10485760
#SMTP_MAX_RECIPIENTS=50
# Simultaneous SMTP sessions. Each one may hold a whole message in memory;
# connections over the limit are answered with 421 and closed.
#SMTP_MAX_CONNECTIONS=100
#SMTP_READ_TIMEOUT=30s
#SMTP_WRITE_TIMEOUT=30s

# Setting both requires AUTH (PLAIN or LOGIN) from clients.
#SMTP_USERNAME=
#SMTP_PASSWORD=
# Or read the password from a file (leave SMTP_PASSWORD empty).
#SMTP_PASSWORD_FILE=

# Allow AUTH without STARTTLS. Defaults to true only when SMTP_LISTEN is a
# loopback address; set it explicitly to authenticate in clear text over a network.
#SMTP_ALLOW_INSECURE_AUTH=

# Enables STARTTLS. The files must be readable by the mailgun-passport user.
# A renewed certificate is picked up on the next STARTTLS, without a restart.
#SMTP_TLS_CERT_FILE=
#SMTP_TLS_KEY_FILE=

# Outside loopback the relay refuses to start without SMTP_USERNAME/PASSWORD.
# Set this only when a firewall or private network already restricts clients.
#SMTP_ALLOW_UNAUTHENTICATED=false

# Comma-separated domains allowed in MAIL FROM and the From header.
# "*.example.com" matches subdomains, "*" alone allows any sender.
# Empty allows the organization of MAILGUN_DOMAIN: for mg.example.com,
# example.com and *.example.com.
#SMTP_ALLOWED_SENDER_DOMAINS=

# --- Logging ------------------------------------------------------------------
# debug | info | warn | error
#LOG_LEVEL=info
# Logs always go to stderr (journal / container log). Set a path to also write
# a file, e.g. /var/log/mailgun-passport/mailgun-passport.log under systemd.
#LOG_FILE=
