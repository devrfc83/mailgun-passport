# SMTP listen address (submission)
SMTP_LISTEN=127.0.0.1:587
SMTP_DOMAIN=localhost
SMTP_MAX_MESSAGE_BYTES=10485760
SMTP_MAX_RECIPIENTS=50
SMTP_READ_TIMEOUT=30s
SMTP_WRITE_TIMEOUT=30s

# If SMTP_USERNAME and SMTP_PASSWORD are set, the server requires AUTH PLAIN
SMTP_USERNAME=
SMTP_PASSWORD=

# Plain AUTH. Required on localhost without STARTTLS
SMTP_ALLOW_INSECURE_AUTH=true

# Optional: enable STARTTLS on the submission port
SMTP_TLS_CERT_FILE=
SMTP_TLS_KEY_FILE=

# Mailgun credentials (https://app.mailgun.com/settings/api_security)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# us | eu | full URL (e.g. https://api.mailgun.net)
MAILGUN_API_BASE=us
MAILGUN_TIMEOUT=30s
MAILGUN_TESTMODE=false

# parsed: parse MIME and call POST /v3/{domain}/messages
# mime: forward raw MIME to POST /v3/{domain}/messages.mime
MAILGUN_SEND_MODE=parsed

LOG_LEVEL=info
LOG_FILE=/var/log/mailgun-passport.log
